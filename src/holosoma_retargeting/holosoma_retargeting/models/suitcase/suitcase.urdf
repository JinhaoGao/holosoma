<?xml version="1.0" ?>
<robot name="suitcase">
  <dynamics damping="0.5" friction="0.9"/>
  <link name="suitcase_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><mesh filename="suitcase.obj" scale="1 1 1"/></geometry>
      <material name="mat"><color rgba="0.7 0.8 0.9 0.7"/></material>
    </visual>
    <collision name="suitcase">
      <geometry><mesh filename="suitcase.obj" scale="1 1 1"/></geometry>
    </collision>
  </link>
</robot>
