<?xml version='1.0' encoding='utf-8'?>
<robot name="smalltable">
  <dynamics damping="0.5" friction="0.9" />
  <link name="smalltable_link">
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
    <contact>
      <lateral_friction value="0.9" />
      <rolling_friction value="0.5" />
      <stiffness value="30000" />
      <damping value="1000" />
    </contact>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="smalltable.obj" scale="1 1 1" />
      </geometry>
      <material name="mat">
        <color rgba="0.7 0.8 0.9 0.7" />
      </material>
    </visual>
    <collision name="smalltable_collision_000">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_000.obj" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="smalltable_collision_001">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_001.obj" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="smalltable_collision_002">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_002.obj" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="smalltable_collision_003">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_003.obj" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="smalltable_collision_004">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_004.obj" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="smalltable_collision_005">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="collision/smalltable_collision_005.obj" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
</robot>